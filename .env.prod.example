# --- Base Domain Config ---
DOMAIN_MAIN=mydomain.com
DOMAIN_SUB=shop.mydomain.com
EMAIL_DOMAIN=da.mydomain.com

# Database Config
POSTGRES_USER=eplant_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=eplant_prod
DB_HOST=postgres
DB_PORT=5432

# Django Backend config
# NOTE: The backend service loads this file via docker-compose `env_file:`,
# which does NOT expand ${VAR} references (unlike `environment:`/build `args:`
# entries in docker-compose.*.yml, which docker compose itself interpolates).
# Values below must be the LITERAL domains, not ${DOMAIN_MAIN}/${DOMAIN_SUB}
# placeholders, or Django will see the placeholder text as-is and reject
# every request (DisallowedHost) / block CORS. config.settings.prod raises
# ImproperlyConfigured at startup if it detects an unexpanded placeholder.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change_me_django_secret_key
ALLOWED_HOSTS=mydomain.com,shop.mydomain.com,backend
CORS_ALLOWED_ORIGINS=https://mydomain.com,https://shop.mydomain.com
CSRF_TRUSTED_ORIGINS=https://mydomain.com,https://shop.mydomain.com
SECURE_SSL_REDIRECT=False
DEBUG=False
DJANGO_LOG_LEVEL=INFO
GUNICORN_LOG_LEVEL=info
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
IMPORT_PRODUCTS_ON_STARTUP=false

# Admin Credentials Defaults (used in Docker entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@da.mydomain.com
DJANGO_SUPERUSER_PASSWORD=change_me_admin_password

# Default account provisioning
CREATE_DEFAULT_USERS=false
DJANGO_DEFAULT_USER_EMAIL=user@da.mydomain.com
DJANGO_DEFAULT_USER_PASSWORD=change_me_default_user_password

# Mailer configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
# EMAIL_DOMAIN already set in Base Domain Config above
CONTACT_EMAIL_LOCAL_PART=martin
DEFAULT_FROM_EMAIL=noreply@da.mydomain.com
WAREHOUSE_EMAIL=warehouse@da.mydomain.com

# Frontend build-time routing/host setup
VITE_API_URL=/api
VITE_LANDING_HOST=mydomain.com
VITE_SHOP_HOST=shop.mydomain.com
VITE_SITE_URL=https://shop.mydomain.com
VITE_HOME_PAGE_READY=true
VITE_ALLOWED_HOSTS=mydomain.com,shop.mydomain.com
VITE_HMR_HOST=mydomain.com

# Frontend public URL (used in emails)
FRONTEND_URL=https://mydomain.com

# Optional observability
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_API_KEY=
